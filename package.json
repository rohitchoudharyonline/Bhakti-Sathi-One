    "@types/react-helmet-async": "^1.0.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.129.1"
  },
  "overrides": {
