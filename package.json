{
  "name": "bhakti-sathi-one",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "node dist/server.cjs",
    "deploy:cf": "bun run build && bunx wrangler d1 migrations apply DB --remote && wrangler deploy",
    "clean": "rm -rf dist .wrangler",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@google/genai": "^2.4.0",
    "@react-oauth/google": "^0.13.5",
