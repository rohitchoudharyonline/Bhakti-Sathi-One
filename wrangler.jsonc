{
  "name": "bhakti-sathi-one",
  "main": "cms-auth-wrapper.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "cache": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bhakti-sathi-db",
      "database_id": "165b7b99-72e3-443e-aee9-8bf0f8c6c26b2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "bhakti-sathi"
    }
  ]
}
